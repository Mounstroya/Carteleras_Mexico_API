# Opcional. Solo hace falta si Cinepolis bloquea la IP donde corre este
# script (pasa con IPs de datacenter/cloud, Cloudflare las detecta). Si se
# define, cinepolis_api.py enruta las llamadas GraphQL por un relay HTTP
# corriendo en una IP residencial en vez de pegarle directo a la API.
#
# Copia este archivo a .env (que ya esta en .gitignore, nunca se sube) y
# llena los valores reales.
CINEPOLIS_RELAY_URL=http://tu-ip-residencial:8794
CINEPOLIS_RELAY_TOKEN=
